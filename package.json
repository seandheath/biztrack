{
  "name": "biztrack",
  "version": "0.2.1",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node tests/auth.mjs && node tests/cleanup.mjs && node tests/replacement.mjs && node tests/versions.mjs && node tests/demo.mjs && node tests/drivers.mjs && node tests/upgrade.mjs && python3 tests/releases.py",
    "dev": "vite dev",
    "dev:demo": "BIZTRACK_BASE_PATH=/demo vite dev --host 127.0.0.1",
    "build": "vite build",
    "build:demo": "BIZTRACK_BASE_PATH=/demo vite build",
    "preview": "vite preview",
    "preview:site": "python3 scripts/preview-site.py",
    "check": "svelte-kit sync && tsc --noEmit"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.55.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.2.2",
    "@vite-pwa/sveltekit": "^1.1.0",
    "svelte": "^5.55.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "workbox-build": "^7.4.0",
    "workbox-expiration": "^7.4.0",
    "workbox-strategies": "^7.4.0",
    "workbox-window": "^7.4.0"
  }
}
